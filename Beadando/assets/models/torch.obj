# Simple low-poly torch model for Haunted Room
# Compatible with simple OBJ loaders using v and f lines only

# handle vertices - rectangular wooden handle
v -0.08 -0.08 -0.70
v  0.08 -0.08 -0.70
v  0.08  0.08 -0.70
v -0.08  0.08 -0.70

v -0.08 -0.08  0.35
v  0.08 -0.08  0.35
v  0.08  0.08  0.35
v -0.08  0.08  0.35

# metal holder / torch head
v -0.16 -0.16  0.35
v  0.16 -0.16  0.35
v  0.16  0.16  0.35
v -0.16  0.16  0.35

v -0.14 -0.14  0.55
v  0.14 -0.14  0.55
v  0.14  0.14  0.55
v -0.14  0.14  0.55

# flame vertices - simple diamond flame
v  0.00  0.00  1.05
v -0.18  0.00  0.55
v  0.18  0.00  0.55
v  0.00 -0.18  0.55
v  0.00  0.18  0.55
v  0.00  0.00  0.38

